# ============================================================
# chain-serve 工作区 .gitignore
# 目标：绑定到 WenchaoChen1/CSS 做文档/配置版本管理，
#       但排除 (1) 前后端代码 (2) 一切真实凭证与生产数据。
# ============================================================

# ===== 前后端代码文件夹（各自绑定官方仓库，独立管理，不在本工作区提交）=====
/CSS_backend-main/
/CSS_frontend-main/

# ===== 凭证 / 环境变量（含真实密钥，严禁提交）=====
# 约定：*.local / *.local.* 后缀即为含真实凭证的私有文件
*.local
*.local.*
# 所有 .env 及其变体一律忽略；仅放行 *.example 模板（提交前仍需确认无真值）
.env
*.env
.env.*
*.env.*
!*.env.example
!*.env.*.example
backend_test_env_file/

# ===== 部署包：env 目录全是真实凭证，仅保留 *.example 模板 =====
部署包/env/
!部署包/env/**/
!部署包/env/**/*.example
部署包/apps/

# ===== 生产数据库备份 / dump（含真实业务数据，且体积大）=====
backups/
*.dump

# ===== 安全审计报告（含真实泄露凭证作为证据，脱敏前严禁提交）=====
审计报告/

# ===== 漏洞复现 / 攻击脚本（武器化，暴露线上漏洞利用方式，禁止提交）=====
repro_c1_idor.py
repro_*.py

# ===== 数据库结构/差异分析工件（本地分析产物）=====
db_compare/

# ===== IDE / 编辑器 / 系统 / 杂项 =====
.idea/
.vscode/
.claude/
*.stackdump
.DS_Store
Thumbs.db
*.log
~$*          # Office (Word/Excel) 临时锁文件
