# ===== CSS 后端 PROD 环境变量模板(AWS: EC2 + ECR + S3 + RDS) =====
# 用法:在本目录复制为 backend.env(不入 git),把所有 __CHANGE_ME__ 换成真实值。
# 红线:prod 的所有密钥(API_KEY / JWT_SECRET / PASSWORD_SALT / S3 key / RabbitMQ 密码等)
#      必须全新生成,严禁从 test/uat 复制。
# 生效链路:backend.env 只是本地底稿——AWS 侧唯一事实源是 SSM Parameter Store
#   /css/prod/backend.env(SecureString),改完必须:
#   1) bash docs/新aws账号/11-parameter-store/put-params.sh prod      ← 整份文件上传为一个参数
#   2) bash docs/新aws账号/09-ssm-run-command/deploy-env.sh prod core ← 重新部署(重启生效,改配置无需重建镜像)
# 例外:前端 VITE_*(frontend.env)是构建期烤进镜像的,改完必须重新构建+推送前端镜像。
# 标注:[必填] 缺失/留空会导致容器启动崩溃(pydantic);[按需] 对应功能才需要真实值。
# 判定必填项以 config/*.py 的 pydantic 类为准(无默认值=必填),勿信旧的 .env.example。

ENV=prod
DEPLOY_ENV=prod
COMPOSE_PROJECT_NAME=css-prod
# 让手动 docker compose 也能解析(deploy/aws 脚本会覆盖导出)
ENV_FILE=deploy/.env.prod

# --- AWS / ECR [必填](ECR_REGISTRY / ECR_REPO_PREFIX 决定拉哪个环境的镜像,勿跨环境混用!) ---
# 换组织/账号:改 AWS_ACCOUNT_ID + AWS_REGION + ECR_REGISTRY(+ AWS_PROFILE 指向该账号的本地凭证)。
# 每环境独立仓库(2026-07-28 规范): <env>/css-backend 与 <env>/css-frontend,勿跨环境共用。
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=582797602427
AWS_PROFILE=default
ECR_REGISTRY=582797602427.dkr.ecr.us-east-1.amazonaws.com
ECR_REPO_PREFIX=prod/css-backend
ECR_FRONTEND_PREFIX=prod/css-frontend
IMAGE_TAG=prod

# ===== EC2 部署目标(仅本机 .ps1 脚本兜底用;正式部署走 SSM Run Command,不依赖 SSH) =====
# prod 应用机尚未创建;创建后填其私网 IP(在 css-prod VPC 私有子网,无公网 IP,
# SSH 需经 prod 侧堡垒机跳转)。
DEPLOY_HOST=__CHANGE_ME_prod_ec2_ip__
DEPLOY_USER=ec2-user
DEPLOY_KEY=C:\github-code\chain-serve\css-non-prod-key.pem
DEPLOY_PATH=/opt/css

# ===== 数据库连接(RDS,私有子网、仅内网可达)[必填] =====
# ⚠️ 生产必须用独立 RDS 实例 css-prod(等 Paid plan 开通,尚未创建)——下方 host 暂为
#    css-non-prod 的占位值,css-prod 建好后必须改成它的 endpoint,严禁与非生产共用实例。
# 建库按新命名规范 css-prod-main / css-prod-ocr(见 docs/新aws账号/04、05),并同步更新下方库名值。
# ⚠️ 主密码由 Secrets Manager 托管(90 天自动轮换)——轮换后要同时改【3 处】:
#    POSTGRES_PASSWORD + 文末两个 OCR_*_URL 内嵌的同一密码(URL 里是 %XX 转义),
#    再 put-params + 重新部署。
# 凭证与连库命令速查见工作区根 运维访问速查.local.md(勿提交 git)。
# 安全组只放行 app/网关安全组的 5432;本机连库走堡垒机 SSH 隧道,切勿把 RDS 改成公网可访问。
POSTGRES_HOST=css-non-prod.cw9qimi6uo6c.us-east-1.rds.amazonaws.com
POSTGRES_DB=css_prod
POSTGRES_USER=cssadmin
POSTGRES_PASSWORD=__CHANGE_ME__
POSTGRES_PORT=5432

# --- 运行参数 [必填] ---
# DEBUG=0 时 FastAPI 会关闭 /api/docs(访问返回 404 属正常现象,不是故障);生产保持 0。
PYTHONPATH=.
PORT=8080
APP_WORKERS_NUMBER=4
APP_INTERNAL_PORT=8000
MESSENGER_APP_WORKERS_NUMBER=2
MESSENGER_APP_INTERNAL_PORT=8001
NOTIFICATIONS_APP_WORKERS_NUMBER=2
NOTIFICATIONS_APP_INTERNAL_PORT=8002
DEBUG=0
SQL_ECHO=0
LOG_LEVEL=20

# --- 认证 [必填] ---
# ⚠️ API_KEY 必须等于前端 frontend.env 的 VITE_X_API_KEY,不一致则所有 /api 请求 401。
API_KEY=__CHANGE_ME__
JWT_SECRET=__CHANGE_ME_long_random__
CONFIRMATION_CODE_RESEND_TIME_INTERVAL=60
CONFIRMATION_CODE_VERIFICATION_ENABLED=true

# --- 密码哈希 [必填] ---
# ⚠️ PASSWORD_SALT 定下后不可再改:改动会导致所有已存在用户的密码哈希对不上、全体无法登录;
#    从其他环境导入用户数据时必须连同其原 SALT 一起带过来。
PASSWORD_HASH_ALGORITHM=sha256
PASSWORD_SALT=__CHANGE_ME__
PASSWORD_HASH_ITERATIONS=100000

# --- S3 = AWS S3 [必填] ---
# ENDPOINT_URL 留空即走真实 AWS S3(config/s3_settings.py)。
# 用一个只有该桶读写权限的 IAM 用户的 AK/SK(代码要求显式密钥,不走实例角色)。
# 本环境对应 IAM 用户 css-app-prod(内联策略只授权本桶);key 暂未生成,用时执行:
#   docs/新aws账号/07-iam/create-app-s3-user.sh prod --new-key   (只打印这一次)
S3_ACCESS_KEY_ID=__CHANGE_ME__
S3_SECRET_ACCESS_KEY=__CHANGE_ME__
S3_ENDPOINT_URL=
# 桶名带账号 ID 后缀 582797602427:S3 桶名是【全球唯一】命名空间(跨账号跨区域共用),
# 纯名 css-test / css-prod 早被别的 AWS 账号占用,故全环境统一用 css-<env>-<账号ID>。
S3_STORAGE_BUCKET_NAME=css-prod-582797602427
S3_LOCATION=us-east-1

# --- Email / SMTP [必填:email_sender 容器启动即校验,留空会崩溃循环重启] ---
# 没有真实 SMTP 时也要填占位值(hostname/port/user/pass),否则 email_sender 起不来。
EMAIL_FROM_ACCOUNT=no-reply@yourdomain.com
EMAIL_TEMPLATES_PATH=./templates
SMTP_HOSTNAME=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=placeholder
SMTP_PASSWORD=placeholder
SMTP_USE_TLS=true

# --- Kafka(EC2 容器)[KAFKA_HOST/PORT 必填] ---
# ⚠️ Kafka 是登录的硬依赖:auth 启动时就会连 kafka:9092 起 producer,infra 栈没起来登录直接 500。
KAFKA_HOST=kafka
KAFKA_PORT=9092
KAFKA_SMS_SEND_TOPIC=sms_send
KAFKA_EMAIL_SEND_TOPIC=email_send
# kafka-ui(2FA 看码)在 tools profile;prod 默认不启用——如需临时排查,只经 SSH 隧道访问,
# 严禁在安全组对公网放行 8085。
KAFKA_UI_PORT=8085

# --- 短信 Twilio [按需:真实发短信] ---
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_PHONE_NUMBER=
SMS_SENDER_RETRIES_COUNT=3
EMAIL_SENDER_RETRIES_COUNT=3

# --- Catalog OCR 客户端 [必填:主 app 的 Settings 会校验,缺则崩溃] ---
CATALOG_OCR_BASE_URL=http://ocr-api:8080
# ⚠️ 必须与下方 OCR_API_KEY 完全一致(主 app 用它调 ocr-api,不一致则全部 401)
CATALOG_OCR_API_KEY=__CHANGE_ME__

# --- Eden AI [按需:发票 OCR] ---
EDEN_API_TOKEN=
EDEN_AI_AVAILABLE_KEY=eden_ai_available
# RECOGNIZE_NEW_MASTER_INVOICES / SPRING_SECURITY_*:代码中无引用(遗留),无需真实值
RECOGNIZE_NEW_MASTER_INVOICES="0 * * * * *"

# --- Worker [必填] ---
WORKER_HOST=redis
WORKER_PORT=6379
WORKER_DB=1

# --- 路径 / 杂项 [必填] ---
PATH_BASE=https://prod.yourdomain.com/
PATH_REGISTRATION=register/
SPRING_SECURITY_USER_NAME=unused
SPRING_SECURITY_USER_PASSWORD=unused
AUTHORIZED_USERS_EMAILS=["admin@yourdomain.com"]

# --- RabbitMQ(EC2 容器)[通知用] ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=__CHANGE_ME__
RABBITMQ_PASSWORD=__CHANGE_ME__
RABBITMQ_VHOST=%2F

# --- ai_assistant (OpenAI;按需) ---
OPENAI_API_KEY=
APP_URL=https://prod.yourdomain.com

# ============================================================
# Catalog OCR 微服务(DB 在 RDS,Redis 是容器 ocr-redis)
OCR_API_PORT=8088
OCR_API_KEY=__CHANGE_ME__
OCR_REDIS_HOST=ocr-redis
OCR_REDIS_PORT=6379
OCR_REDIS_DB=2
# DSN 指向 RDS(OCR 库尚未创建;建库按新命名规范 css-prod-ocr,并同步更新下方 DSN 尾部库名;
# host 同上,css-prod 实例建好后一并改)。
# ⚠️ __PASSWORD__ 与上方 POSTGRES_PASSWORD 是同一个 RDS 密码(URL 里特殊字符要 %XX 转义);
#    密码轮换后 POSTGRES_PASSWORD + 这两条 URL 共 3 处必须同时改。
# ⚠️ 上方 CATALOG_OCR_API_KEY 必须与本段 OCR_API_KEY 填同一个值。
OCR_DATABASE_URL=postgresql+asyncpg://__USER__:__PASSWORD__@css-non-prod.cw9qimi6uo6c.us-east-1.rds.amazonaws.com:5432/ocr_prod
OCR_ALEMBIC_DATABASE_URL=postgresql+psycopg2://__USER__:__PASSWORD__@css-non-prod.cw9qimi6uo6c.us-east-1.rds.amazonaws.com:5432/ocr_prod
GEMINI_API_KEY=__CHANGE_ME__
GEMINI_OCR_MODEL=gemini-3.1-flash-lite-preview
GEMINI_ENTITY_MODEL=gemini-3.1-flash-lite-preview
# 其余 OCR 调参(超时/并发/成本上限等)见 catalog_ocr_service/.env.example
