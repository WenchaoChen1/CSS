# ===== 前端 PROD 环境构建配置模板 =====
# 用法:在本目录复制为 frontend.env(不入 git)并填真实值;AWS 侧唯一事实源是
# SSM Parameter Store /css/prod/frontend.env。
# 红线:prod 的 VITE_X_API_KEY 等密钥必须全新生成,严禁从 test/uat 复制。
# ⚠️ VITE_* 是【构建时】烤进静态 JS 的,改动后必须:
#    1) bash docs/新aws账号/11-parameter-store/put-params.sh prod 上传;
#    2) 重新构建+推送前端镜像(走 CI,或 docs/新aws账号/08-github-actions推镜像 的 push-ecr.sh);
#    3) bash docs/新aws账号/09-ssm-run-command/deploy-env.sh prod frontend 重新部署。
#    仅重启容器无效!

VITE_NODE_ENV='production'

# 同源路径(前端容器 nginx 反代到后端),保持 /api 不变。
# 走的是浏览器当前访问的地址,也就是本环境 ALB;绑域名后无需改动。
VITE_API_BASE_URL='/api'

# WebSocket 指向【本环境 ALB】的 DNS(prod = ALB css-prod),不再是 EC2 IP 或堡垒机 EIP
# —— 应用机在私有子网无公网 IP,Web 一律只经本环境 ALB 进来。
# ⏳ ALB css-prod 尚未创建(docs/新aws账号/12-alb/create-alb.sh prod),建好后把 DNS 填进来。
# ⚠️ 生产应绑域名 + ACM 证书走 wss://<域名>;且 VITE_* 是【构建期烤入】的,
#    改完必须重新 build-push 前端镜像再 deploy,重启容器无效。
VITE_WS_BASE_URL='ws://<css-prod ALB DNS 或域名>'

# ⚠️ 必须等于 deploy-env/prod/backend.env 的 API_KEY,不一致则所有 /api 请求 401
VITE_X_API_KEY='<与后端 API_KEY 一致>'

VITE_GOOGLE_MAPS_API_KEY=''
