# ===== 前端 UAT 环境构建配置模板 =====
# 复制为 frontend.env 并填真实值。⚠️ VITE_* 是【构建时】烤进静态 JS 的,
# 改动后必须重新 build-push 前端镜像(bin\打镜像推ECR.ps1 -EnvName uat)再 deploy frontend。

VITE_NODE_ENV='production'

# 同源路径(前端容器 nginx 反代到后端),保持 /api 不变
VITE_API_BASE_URL='/api'

# 换成 uat 环境 EC2 的地址(建议绑 Elastic IP,否则重启换 IP 要重建镜像)
VITE_WS_BASE_URL='ws://<UAT-EC2-IP>'

# 必须等于 deploy-env/uat/backend.env 的 API_KEY
VITE_X_API_KEY='<与后端 API_KEY 一致>'

VITE_GOOGLE_MAPS_API_KEY=''
